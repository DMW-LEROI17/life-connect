# URL publique de l'application (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=remplace-moi-par-la-cle-service-role

# Administration — OBLIGATOIRE : choisir un mot de passe long et unique.
# Ne jamais laisser la valeur d'exemple en production.
ADMIN_PASSWORD=

# OBLIGATOIRE : générer une chaîne aléatoire de 32 octets minimum avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# WhatsApp de l'administrateur (format international sans +)
NEXT_PUBLIC_ADMIN_WHATSAPP=237672115570
